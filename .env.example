# Canonical site URL used for sitemap.xml, robots.txt and hreflang tags
NEXT_PUBLIC_SITE_URL=https://gsirigo.com

# Google Analytics 4 measurement ID (optional — analytics stays disabled without it)
NEXT_PUBLIC_GA_ID=

# Travelpayouts attribution marker / sub_id (optional for the draft widget).
# At integration time, replace the mock widget with the real embed snippet from
# the Travelpayouts dashboard (see components/car-rental-widget.tsx + lib/partners.ts).
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
NEXT_PUBLIC_TRAVELPAYOUTS_SUB_ID=