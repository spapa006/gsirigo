# Single-admin authentication (server-only — never expose to the client)
ADMIN_EMAIL=you@example.com
# bcrypt hash of your admin password — generate with: npm run password:hash -- "<password>"
# IMPORTANT: env files expand `$var` (dotenv-expand). Escape every `$` as `\$` or the
# hash is silently mangled (e.g. `$2b$12$...` becomes `2b12...`). The script prints
# the ready-to-paste escaped form.
ADMIN_PASSWORD_HASH=
# Random secret (32+ chars) signing the httpOnly admin session cookie — generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Database — default is a local SQLite file (./data/gsirigo.db) for development.
# Production (Vercel): the Turso Marketplace integration sets these automatically:
#   TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token>
# Manual setup may use LIBSQL_URL / LIBSQL_AUTH_TOKEN instead (DATABASE_URL is
# an accepted alias for the URL). Precedence: TURSO_DATABASE_URL > LIBSQL_URL >
# DATABASE_URL, and TURSO_AUTH_TOKEN > LIBSQL_AUTH_TOKEN. Run `npm run db:seed`
# once (with the remote DB env vars set) to import the catalog.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=
DATABASE_URL=

# Canonical site URL used for sitemap.xml, robots.txt and hreflang tags
NEXT_PUBLIC_SITE_URL=https://gsirigo.com

# Google Analytics 4 measurement ID (optional — analytics stays disabled without it)
NEXT_PUBLIC_GA_ID=

# Travelpayouts attribution marker / sub_id (optional draft-widget defaults;
# the admin Settings page can override these at runtime).
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
NEXT_PUBLIC_TRAVELPAYOUTS_SUB_ID=